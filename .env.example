# This is a static, backend-free demo build — no API URL or secrets needed.
# Copy to .env.local to re-skin the demo (white-label) without touching code.
# For a real Cloudflare Pages deploy, set these under
# Pages project -> Settings -> Environment variables (optional; sensible
# defaults are used if you skip this entirely).

VITE_BRAND_NAME=Nexus Reviews
VITE_BRAND_LOGO_URL=
VITE_BRAND_COLOR=#3730A3
VITE_BRAND_COLOR_HOVER=#2E2A87
VITE_BRAND_COLOR_SOFT=#EEEDFB
VITE_SUPPORT_EMAIL=support@example.com
